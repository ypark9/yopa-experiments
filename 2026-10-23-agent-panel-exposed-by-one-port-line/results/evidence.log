## b01  input: python3 panel.py --host 127.0.0.1 --port 18001
$ ss -H -ltnp "sport = :18001"
LISTEN 0      5      127.0.0.1:18001 0.0.0.0:* users:(("python3",pid=N,fd=N))
$ lsof -nP -iTCP:18001 -sTCP:LISTEN
COMMAND TYPE NODE NAME 
python3 IPv4 TCP 127.0.0.1:18001 (LISTEN)
$ ./check-listeners.sh 18001
ok       127.0.0.1:18001
exit=0

## b02  input: python3 panel.py --host 0.0.0.0 --port 18002
$ ss -H -ltnp "sport = :18002"
LISTEN 0      5      0.0.0.0:18002 0.0.0.0:* users:(("python3",pid=N,fd=N))
$ lsof -nP -iTCP:18002 -sTCP:LISTEN
COMMAND TYPE NODE NAME 
python3 IPv4 TCP *:18002 (LISTEN)
$ ./check-listeners.sh 18002
EXPOSED  0.0.0.0:18002
exit=1

## p03  input: docker run -p 18003:8000 ... --host 127.0.0.1
$ ss -H -ltnp "sport = :18003"
LISTEN 0      4096   0.0.0.0:18003 0.0.0.0:* users:(("docker-proxy",pid=N,fd=N))
LISTEN 0      4096      [::]:18003    [::]:* users:(("docker-proxy",pid=N,fd=N))
$ lsof -nP -iTCP:18003 -sTCP:LISTEN
COMMAND TYPE NODE NAME 
docker-pr IPv4 TCP *:18003 (LISTEN)
docker-pr IPv6 TCP *:18003 (LISTEN)
$ docker port p03
8000/tcp -> 0.0.0.0:18003
8000/tcp -> [::]:18003
$ iptables -t nat -S DOCKER | grep 18003
-A DOCKER ! -i docker0 -p tcp -m tcp --dport 18003 -j DNAT --to-destination 172.17.0.2:8000
$ ./check-listeners.sh 18003
EXPOSED  0.0.0.0:18003
EXPOSED  [::]:18003
EXPOSED  docker p03 0.0.0.0:18003->8000/tcp
EXPOSED  docker p03 :::18003->8000/tcp
exit=1

