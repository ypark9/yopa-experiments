## p05  input: docker run -p 127.0.0.1:18005:8000 ... --host 0.0.0.0
$ ss -H -ltnp "sport = :18005"
LISTEN 0      4096   127.0.0.1:18005 0.0.0.0:* users:(("docker-proxy",pid=N,fd=N))
